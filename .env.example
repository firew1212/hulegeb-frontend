# Public frontend configuration.
# Copy this file to .env.local and adjust values for your machine.
# Only NEXT_PUBLIC_ variables are exposed to the browser.

# Absolute http(s) URL of the Hulegeb backend API (no credentials, query, or fragment).
# The backend defaults to port 3000; the frontend dev server uses port 4000.
# NEXT_PUBLIC_ values are embedded into the browser bundle at build time.
# Use HTTPS for deployed environments.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
