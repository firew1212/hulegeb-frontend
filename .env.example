# Public frontend configuration.
# Copy this file to .env.local and adjust values for your machine.
# Only NEXT_PUBLIC_ variables are exposed to the browser.

# Base URL of the Hulegeb backend API.
# The backend defaults to port 3000 (see back-end docs).
# If the frontend dev server also uses port 3000, run one of them on another port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
